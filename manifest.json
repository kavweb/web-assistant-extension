{
  "manifest_version": 3,
  "name": "دستیار وب‌گردی",
  "version": "0.1.0",
  "description": "دستیار رایگان و ساده برای وب‌گردی: پیدا کردن دکمه، خلاصه‌ی پاراگراف‌ها و ساده‌سازی صفحه.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "http://localhost:11434/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "options_page": "options.html",
  "action": { "default_title": "دستیار وب‌گردی" }
}
